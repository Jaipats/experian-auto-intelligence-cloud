# Copy to .env (gitignored) and fill in. Read by scripts/deploy.sh and scaffold/06_sharing/create_share.sh.

# --- Required ---------------------------------------------------------------
DATABRICKS_CONFIG_PROFILE=DEFAULT        # Databricks CLI profile for the target workspace
CATALOG=                                 # existing UC catalog you can CREATE SCHEMA in
WAREHOUSE_ID=                            # SQL warehouse id (serverless recommended)

# --- Optional (defaults shown) ----------------------------------------------
# SCHEMA=experian_auto
# APP_NAME=experian-copilot              # ≤ 30 chars, lowercase/digits/hyphens
# ENDPOINT_PREFIX=experian               # → <prefix>-residual-value, -days-to-turn, -default-risk
# GENIE_SPACE_TITLE='Experian Auto Intelligence — Genie'   # quote values with spaces

# Lakebase Autoscaling project (created by deploy.sh if missing). To reuse an existing
# project/database, set all four:
# LAKEBASE_PROJECT=experian-auto-oltp
# LAKEBASE_BRANCH=production
# LAKEBASE_DATABASE_ID=databricks-postgres
# LAKEBASE_PG_DATABASE=databricks_postgres

# Governance. The deployer and the app SP always get full access.
# FULL_ACCESS_PRINCIPALS=colleague@example.com,another@example.com
# Demo customers (service principals or users) scoped by the row filter / column mask:
# TENANT_CONTRACTS='[{"principal":"<sp-application-id>","customer":"Contoso Dealer Group","tier":"standard","states":["CA","NV","AZ"]},{"principal":"<sp-application-id>","customer":"Northwind Auto Finance","tier":"full","states":["TX","FL"]}]'

# Delta Sharing (scaffold/06_sharing/create_share.sh, needs CREATE SHARE on the metastore)
# SHARE_NAME=experian_auto_share
# RECIPIENT_NAME=demo_customer
